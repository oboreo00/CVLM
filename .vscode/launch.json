{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug CVLM Server",
      "program": "${workspaceFolder}/server/index.ts",
      "runtimeArgs": [
        "--env-file=.env",
        "--import",
        "tsx"
      ],
      "skipFiles": [
        "<node_internals>/**"
      ],
      "console": "integratedTerminal"
    }
  ]
}